\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Attention score between a query at position 0 and keys at ordinal positions 0--1023, computed with a 512-dimensional unit vector ($\mathbf  {q} = \mathbf  {k} = \mathbf  {1}/\sqrt  {512}$) under four RoPE bases ($10^4$, $10^5$, $10^6$, $10^7$). All bases produce a monotone global decay with small high-frequency oscillations whose period grows with the base.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:rope_analysis}{{2}{10}{Attention score between a query at position 0 and keys at ordinal positions 0--1023, computed with a 512-dimensional unit vector ($\mathbf {q} = \mathbf {k} = \mathbf {1}/\sqrt {512}$) under four RoPE bases ($10^4$, $10^5$, $10^6$, $10^7$). All bases produce a monotone global decay with small high-frequency oscillations whose period grows with the base}{figure.2}{}}
