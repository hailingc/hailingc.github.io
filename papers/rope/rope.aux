\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Attention score of a SIREN-RoPE module (weights extracted from the production model) as the key timestamp is swept across four time spans, using a 128-dimensional unit vector for both query and key. Each panel overlaps two consecutive periods (day 1 vs.\ day 2; week 1 vs.\ week 2; month 1 vs.\ month 2; year 1 vs.\ year 2) to reveal repeating structure.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:sweep_time}{{3}{11}{Attention score of a SIREN-RoPE module (weights extracted from the production model) as the key timestamp is swept across four time spans, using a 128-dimensional unit vector for both query and key. Each panel overlaps two consecutive periods (day 1 vs.\ day 2; week 1 vs.\ week 2; month 1 vs.\ month 2; year 1 vs.\ year 2) to reveal repeating structure}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Strong intra-day periodicity.}{11}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Strong weekly periodicity.}{11}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{No monthly (30 days) periodicity.}{11}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Yearly decay only.}{11}{section*.30}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Frequency-domain analysis.}{11}{section*.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Year-long SIREN-RoPE attention in the time domain (top) and its FFT magnitude spectrum (bottom). Vertical dashed lines mark the weekly ($\frac  {1}{7}$\,cycles/day) and daily (1\,cycle/day) frequencies. Both frequencies exhibit prominent peaks; sub-harmonics at $\frac  {1}{2}$, $\frac  {1}{3}$, \ldots  cycles/day are also visible.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:year_fft}{{4}{12}{Year-long SIREN-RoPE attention in the time domain (top) and its FFT magnitude spectrum (bottom). Vertical dashed lines mark the weekly ($\frac {1}{7}$\,cycles/day) and daily (1\,cycle/day) frequencies. Both frequencies exhibit prominent peaks; sub-harmonics at $\frac {1}{2}$, $\frac {1}{3}$, \ldots cycles/day are also visible}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Joint ordinal--temporal attention landscape.}{12}{section*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 2D attention score heatmap as a function of key ordinal position (y-axis, 0--120) and key timestamp (x-axis) for four time spans. Color encodes attention magnitude (brighter = higher). The ordinal axis exhibits monotone decay irrespective of the time span; the temporal axis exhibits clear intra-day and intra-week oscillations in the short-span panels.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:attn_heatmap}{{5}{13}{2D attention score heatmap as a function of key ordinal position (y-axis, 0--120) and key timestamp (x-axis) for four time spans. Color encodes attention magnitude (brighter = higher). The ordinal axis exhibits monotone decay irrespective of the time span; the temporal axis exhibits clear intra-day and intra-week oscillations in the short-span panels}{figure.5}{}}
